    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-calendar-datetime-picker": "^2.0.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router": "^7.16.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "xlsx": "^0.18.5",
